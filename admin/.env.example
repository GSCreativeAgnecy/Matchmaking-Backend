# API base URL used by the BROWSER. When empty, the browser calls the same
# origin (/api/v1/...) and a reverse proxy routes it to the API.
# Values are public — never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000

# SERVER-ONLY internal API target used by the Next.js BFF auth routes
# (login/totp/refresh/logout/me). Not inlined into the browser bundle.
# Example (Docker): http://api:8000
# ADMIN_API_URL=http://api:8000
